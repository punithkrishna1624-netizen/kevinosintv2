# Required for public deployment — sets the shared access code for your
# team/class. Leave unset only for local single-user testing.
ACCESS_CODE=

# Random secret for Flask session signing. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: enables the breach-check module (haveibeenpwned.com/API/Key)
HIBP_API_KEY=

# Optional: for multi-instance deployments, point rate limiting at Redis
# instead of in-memory storage, e.g. redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://
